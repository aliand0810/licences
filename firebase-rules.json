{
  "rules": {
    "limits": {
      ".read": true,
      "$lic": { ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'" }
    },
    "devices": {
      ".read": true,
      "$lic": {
        ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
        "$slot": {
          ".write": "newData.exists() && $slot.length === 2 && root.child('limits').child($lic).exists() && $slot < root.child('limits').child($lic).val() && (!data.exists() || data.child('id').val() === newData.child('id').val())",
          ".validate": "newData.hasChildren(['id','t']) && newData.child('id').isString() && newData.child('id').val().length <= 40"
        }
      }
    },
    "excess": {
      ".read": true,
      "$lic": {
        ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
        "$dev": {
          ".write": "newData.exists() && $dev.length <= 40 && root.child('limits').child($lic).exists()",
          ".validate": "newData.hasChildren(['t'])"
        }
      }
    }
  }
}
