{
  "rules": {
    "limits": {
      ".read": true,
      "$lic": {
        ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'"
      }
    },
    "devices": {
      ".read": true,
      "$lic": {
        ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
        "$slot": {
          ".write": "newData.exists() && $slot.length === 2 && root.child('limits').child($lic).exists() && $slot < root.child('limits').child($lic).val() && (!data.exists() || data.child('id').val() === newData.child('id').val())",
          ".validate": "newData.hasChildren(['id','t']) && newData.child('id').isString() && newData.child('id').val().length <= 40"
        }
      }
    },
    "excess": {
      ".read": true,
      "$lic": {
        ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
        "$dev": {
          ".write": "newData.exists() && $dev.length <= 40 && root.child('limits').child($lic).exists()",
          ".validate": "newData.hasChildren(['t'])"
        }
      }
    },
    "requests": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$rid": {
        ".read": true,
        ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || (!data.exists() && newData.exists())",
        ".validate": "$rid.length >= 20 && $rid.length <= 40 && newData.hasChildren(['email','produit','t']) && newData.child('email').isString() && newData.child('email').val().length <= 120 && newData.child('produit').isString() && newData.child('produit').val().length <= 60 && (!newData.child('message').exists() || (newData.child('message').isString() && newData.child('message').val().length <= 1000)) && (!newData.child('nom').exists() || (newData.child('nom').isString() && newData.child('nom').val().length <= 80))"
      }
    },
    "crm": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'"
    },
    "support": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$tid": {
        ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || (!data.exists() && newData.exists())",
        ".validate": "$tid.length >= 20 && $tid.length <= 40 && newData.hasChildren(['email','produit','t','message']) && newData.child('email').isString() && newData.child('email').val().length <= 120 && newData.child('message').isString() && newData.child('message').val().length <= 2000 && newData.child('produit').isString() && newData.child('produit').val().length <= 60",
        ".read": true,
        "msgs": {
          "$mid": {
            ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || (!data.exists() && newData.exists() && newData.child('from').val() === 'client')",
            ".validate": "$mid.length <= 40 && newData.hasChildren(['from','text','t']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
          }
        },
        "statut": {
          ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || newData.val() === 'nouveau'"
        }
      }
    }
  }
}