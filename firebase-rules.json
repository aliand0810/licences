{
  "rules": {
    "limits": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$lic": {
        ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'"
      }
    },
    "devices": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$lic": {
        ".read": true,
        ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
        "$slot": {
          ".write": "newData.exists() && $slot.matches(/^[0-9][0-9]$/) && root.child('limits').child($lic).exists() && auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid || (!data.child('uid').exists() && data.child('id').val() === newData.child('id').val()))",
          ".validate": "newData.hasChildren(['id','t'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "seen": {
            ".validate": "newData.isNumber()"
          },
          "off": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "excess": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$lic": {
        ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
        "$dev": {
          ".write": "newData.exists() && $dev.length <= 40 && root.child('limits').child($lic).exists()",
          ".validate": "newData.hasChildren(['t'])"
        }
      }
    },
    "requests": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$rid": {
        ".read": true,
        ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || (!data.exists() && newData.exists())",
        ".validate": "$rid.length >= 20 && $rid.length <= 40 && newData.hasChildren(['email','produit','t']) && newData.child('email').isString() && newData.child('email').val().length <= 120 && newData.child('produit').isString() && newData.child('produit').val().length <= 60 && (!newData.child('message').exists() || (newData.child('message').isString() && newData.child('message').val().length <= 1000)) && (!newData.child('nom').exists() || (newData.child('nom').isString() && newData.child('nom').val().length <= 80))"
      }
    },
    "crm": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'"
    },
    "support": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$tid": {
        ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || (!data.exists() && newData.exists())",
        ".validate": "$tid.length >= 20 && $tid.length <= 40 && newData.hasChildren(['email','produit','t','message']) && newData.child('email').isString() && newData.child('email').val().length <= 120 && newData.child('message').isString() && newData.child('message').val().length <= 2000 && newData.child('produit').isString() && newData.child('produit').val().length <= 60",
        ".read": true,
        "msgs": {
          "$mid": {
            ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || (!data.exists() && newData.exists() && newData.child('from').val() === 'client')",
            ".validate": "$mid.length <= 40 && newData.hasChildren(['from','text','t']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
          }
        },
        "statut": {
          ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || newData.val() === 'nouveau'"
        }
      }
    },
    "nav": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$lic": {
        "$dev": {
          "$e": {
            ".write": "!data.exists() && newData.exists() && $dev.length <= 40",
            ".validate": "newData.hasChildren(['t','p']) && newData.child('p').isString() && newData.child('p').val().length <= 60 && (!newData.child('n').exists() || newData.child('n').val().length <= 60) && (!newData.child('ti').exists() || newData.child('ti').val().length <= 60)"
          }
        }
      }
    },
    "reload": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$lic": {
        ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
        ".read": true
      }
    },
    "ipblock": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$ip": {
        ".read": true
      }
    },
    "annonces": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'"
    },
    "annoncesWait": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$id": {
        ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || (!data.exists() && newData.exists())",
        ".validate": "$id.length >= 10 && $id.length <= 40 && newData.hasChildren(['title','price','t']) && newData.child('title').isString() && newData.child('title').val().length <= 80"
      }
    },
    "membresIdx": {
      ".read": true,
      "$k": {
        ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || !data.exists() || root.child('requests').child(data.val()).child('statut').val() === 'refusee'",
        ".validate": "newData.isString() && newData.val().length <= 40"
      }
    },
    "inbox": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$o": {
        "$t": {
          ".write": "!data.exists() && newData.exists() && root.child('support').child($t).exists()",
          ".validate": "newData.isNumber() && $o.length <= 40 && $t.length <= 40"
        },
        ".read": true
      }
    },
    "flash": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'"
    },
    "secu": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$e": {
        ".write": "(auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63') || (!data.exists() && newData.exists())",
        ".validate": "$e.length >= 10 && $e.length <= 40 && newData.hasChildren(['t','r','lic','p']) && newData.child('t').isNumber() && newData.child('t').val() <= now + 300000 && newData.child('r').isString() && newData.child('r').val().length <= 12 && newData.child('lic').isString() && newData.child('lic').val().length <= 80 && newData.child('p').isString() && newData.child('p').val().length <= 60 && (!newData.child('u').exists() || (newData.child('u').isString() && newData.child('u').val().length <= 60)) && (!newData.child('ip').exists() || (newData.child('ip').isString() && newData.child('ip').val().length <= 45))"
      }
    },
    "devmeta": {
      ".read": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      ".write": "auth != null && auth.uid === 'P9ycnnKJF9dV2fPiW6b2xTgb0V63'",
      "$lic": {
        "$slot": {
          ".write": "auth != null && root.child('devices').child($lic).child($slot).child('uid').val() === auth.uid",
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "ua": {
            ".validate": "newData.isString() && newData.val().length <= 400"
          },
          "seen": {
            ".validate": "newData.isNumber()"
          },
          "lastIp": {
            ".validate": "newData.isString() && newData.val().length <= 45"
          },
          "lastLoc": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "h": {
            "$t": {
              ".validate": "$t.matches(/^[0-9]{10,13}$/) && newData.hasChildren(['ip'])",
              "ip": {
                ".validate": "newData.isString() && newData.val().length <= 45"
              },
              "loc": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "$o": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}